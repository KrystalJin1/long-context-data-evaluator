cat > .gitignore <<'EOF'
# generated reports and metrics
outputs/
output/
analysis_output/
reports/

# real/private data
data/
real_data/
examples/0601数据/
*.jsonl
*.jsonl.gz
*.parquet
*.csv
*.html
*.log

# python cache
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# system files
.DS_Store

# secrets
.env
*.key
*.pem
EOF